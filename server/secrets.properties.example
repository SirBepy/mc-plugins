# Copy this file to secrets.properties (gitignored) and fill in real values.
# :server:assembleServer / :server:assembleLocalServer read secrets.properties and write these
# values into the ASSEMBLED copy only (server/dist/ or server/local/), never into server/config/,
# so a real secret never lands in git. See injectSecrets() in server/build.gradle.kts.

# DiscordBot plugin's bot token (Applications > Bot > Token on https://discord.com/developers).
discordbot.token=PUT_YOUR_BOT_TOKEN_HERE

# Minibosses' Guardian Chronicles story key: 32 random bytes, base64. Encrypts/decrypts
# minibosses/src/main/resources/chronicles.enc (:minibosses:encryptChronicles / decryptChronicles)
# and is copied to plugins/Minibosses/chronicles.key. Losing it loses the story text.
minibosses.chronicles-key=PUT_A_BASE64_32_BYTE_KEY_HERE
